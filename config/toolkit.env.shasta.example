# Shasta testnet — ports do not collide with mainnet/nile.
RPCNODE_ENV=shasta
TRON_ENV=shasta
TRON_TAG=GreatVoyage-v4.8.2.1

TRON_OPT=/opt/tron/shasta
TRON_ETC=/etc/tron/shasta
TRON_DATA=/data/tron/shasta
TRON_OUTPUT=/data/tron/shasta/output-directory

TRON_NODE_HTTP_HOST=127.0.0.1
TRON_NODE_HTTP_PORT=18092
RPCNODE_GATEWAY_LISTEN=0.0.0.0
TRON_GATEWAY_LISTEN=0.0.0.0
RPCNODE_PUBLIC_PORT=8092
TRON_PUBLIC_PORT=8092
RPCNODE_GATEWAY_PORT=8092
TRON_GATEWAY_PORT=8092
RPCNODE_PANEL_PORT=8093
TRON_PANEL_PORT=8093
TRON_P2P_PORT=18890
TRON_SYSTEM_AGENT_PORT=29092
# RPCNODE_PUBLIC_BASE=http://203.0.113.10:8092
# RPCNODE_PANEL_BASE=http://203.0.113.10:8093
# Panel stays 8093 unless already bound by another stack.

TRON_DOCKER_FIRST=1
TRON_AGENT_STATE=/var/lib/rpcnode/tron-shasta/agent-state.json
TRON_INSTANCE_FILE=/var/lib/rpcnode/tron-shasta/INSTANCE.json
TRON_REGISTRY_FILE=/etc/rpcnode/instances.d/tron-shasta.json
