# Copy to /etc/tron/mainnet/toolkit.env on the server.
# Product listen vars: RPCNODE_* (canonical). TRON_* aliases kept for one release.
RPCNODE_ENV=mainnet
TRON_ENV=mainnet
TRON_TAG=GreatVoyage-v4.8.2.1

TRON_OPT=/opt/tron/mainnet
TRON_ETC=/etc/tron/mainnet
TRON_DATA=/data/tron/mainnet
TRON_OUTPUT=/data/tron/mainnet/output-directory

# java-tron on HOST; public entry is Go api-agent (NOT :18090).
TRON_NODE_HTTP_HOST=127.0.0.1
TRON_NODE_HTTP_PORT=18090
RPCNODE_GATEWAY_LISTEN=0.0.0.0
TRON_GATEWAY_LISTEN=0.0.0.0
# Dual listen on api-agent:
RPCNODE_PUBLIC_PORT=8090
TRON_PUBLIC_PORT=8090
RPCNODE_GATEWAY_PORT=8090
TRON_GATEWAY_PORT=8090
RPCNODE_PANEL_PORT=8093
TRON_PANEL_PORT=8093
TRON_P2P_PORT=18888
# Host-network: system-agent internal listen
TRON_SYSTEM_AGENT_PORT=29090
# Public URLs (RPC vs panel)
# RPCNODE_PUBLIC_BASE=http://203.0.113.10:8090
# RPCNODE_PANEL_BASE=http://203.0.113.10:8093
# Deprecated: TRON_PUBLIC_BASE / TRON_PANEL_BASE

TRON_SNAPSHOT_URL=http://34.86.86.229/backup20260808/FullNode_output-directory.tgz
TRON_SNAPSHOT_ENABLED=1

TRON_JAVA_XMX=48g
TRON_JAVA_XMS=48g

TRON_MAX_HTTP_CONNECT=2000
TRON_GLOBAL_QPS=200000
TRON_GLOBAL_IP_QPS=200000

TRON_DOCKER_FIRST=1
TRON_AGENT_STATE=/var/lib/rpcnode/tron-mainnet/agent-state.json
TRON_INSTANCE_FILE=/var/lib/rpcnode/tron-mainnet/INSTANCE.json
TRON_REGISTRY_FILE=/etc/rpcnode/instances.d/tron-mainnet.json

TRON_UPDATER_HOUR_UTC=3
TRON_UPDATER_AUTO_APPLY=1
TRON_UPDATER_WITH_SNAPSHOT=0

# Agent key for /api/v1 + future central registration (rpcnodectl setup generates if empty)
# AGENT_API_TOKEN=
# TRON_API_TOKEN=
# AGENT_DOWNLOAD_URL=https://toolkit.rpcnode.dev/install/agent.sh
