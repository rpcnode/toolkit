# Copy to toolkit root:
#   cp tools/client-watch/client-watch.env.example client-watch.env
# client-watch.env is gitignored.

# GitHub — иначе 60 req/час и 403.
# Создать classic token (scopes не обязательны, хватит public read):
#   https://github.com/settings/tokens/new?description=rpcnode-client-watch
# Список токенов: https://github.com/settings/tokens
GITHUB_TOKEN=

# Telegram — куда слать «сеть — вышла новая версия X».
# Бот: @BotFather → /newbot → токен.
# Chat: напиши боту, потом
#   curl -sS "https://api.telegram.org/bot<TOKEN>/getUpdates"
# и возьми result[0].message.chat.id (для группы часто отрицательный).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT=

CLIENT_WATCH_PORT=8094
# CLIENT_WATCH_CLIENTS_HOST=./install/clients
# CLIENT_WATCH_TOKEN=
