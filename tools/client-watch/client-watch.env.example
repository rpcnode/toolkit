# Copy to toolkit root as client-watch.env (gitignored) or export in .env
# CLIENT_WATCH_TOKEN — Bearer for /api/v1/* (FetchClients «токен API вотчера»)
# GITHUB_TOKEN — иначе GitHub 60 req/час

CLIENT_WATCH_PORT=8094
CLIENT_WATCH_PUBLIC_BASE=https://rpcnode.dev/install
# Host folder with catalog.json (CDN install/clients)
# CLIENT_WATCH_CLIENTS_HOST=/var/www/install/clients
CLIENT_WATCH_TOKEN=
GITHUB_TOKEN=
