#!/bin/bash
# Mithril cardano-db restore (certified snapshot + IOG-signed ancillary ledger state) into {{dest}}/db.
# mithril-client verifies the certificate chain, the Merkle proof and the ancillary signature itself (no Docker).
set -uo pipefail
export LC_ALL=C
ENV='{{env}}'
CLIENT='{{client}}'
DEST='{{dest}}'
DB="$DEST/db"
AGG='{{aggregator}}'
GENESIS_URL='{{genesis_url}}'
ANCILLARY_URL='{{ancillary_url}}'
MARKER='{{marker}}'
STATE='{{state}}'
LOG='{{log}}'
NODE_UNIT="rpcnode-cardano-${ENV}.service"
mkdir -p "$(dirname "$LOG")" "$DEST/.toolkit"
snapdiag() { echo "SNAPSHOT_DIAG $*" | tee -a "$LOG"; }
state() { printf '{"phase":"%s","pct":%s,"detail":"%s","updated_at":"%s"}\n' \
  "$1" "$2" "$3" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STATE"; }
snapdiag "begin pid=$$ env=$ENV dest=$DEST aggregator=$AGG"
trap 'snapdiag "ERR line=$LINENO cmd=$BASH_COMMAND rc=$?"' ERR
trap 'snapdiag "TERM rc=143 - interrupted, not done"; exit 143' TERM
if [ -f "$MARKER" ]; then
  snapdiag "marker present - snapshot already restored"
  state done 100 "Mithril snapshot ready"
  exit 0
fi
if [ ! -x "$CLIENT" ]; then
  snapdiag "ERROR mithril-client missing at $CLIENT"
  state error 0 "mithril-client missing at $CLIENT - sync Cardano clients first"
  exit 1
fi
systemctl stop "$NODE_UNIT" 2>/dev/null || true
state download 0 "Mithril - fetching verification keys"
GENESIS_VERIFICATION_KEY="$(curl -fsSL --connect-timeout 30 --max-time 180 --retry 8 --retry-delay 3 --retry-all-errors "$GENESIS_URL")"
ANCILLARY_VERIFICATION_KEY="$(curl -fsSL --connect-timeout 30 --max-time 180 --retry 8 --retry-delay 3 --retry-all-errors "$ANCILLARY_URL")"
if [ -z "$GENESIS_VERIFICATION_KEY" ] || [ -z "$ANCILLARY_VERIFICATION_KEY" ]; then
  snapdiag "ERROR verification keys not downloadable"
  state error 0 "Mithril verification keys not downloadable ($GENESIS_URL)"
  exit 1
fi
export GENESIS_VERIFICATION_KEY ANCILLARY_VERIFICATION_KEY
# v1: no resume. mithril-client refuses a non-empty db/immutable without --allow-override and then re-downloads everything,
# so a partial restore is wiped here and started again.
snapdiag "wiping partial $DB"
rm -rf "$DB"
state download 1 "Mithril - starting cardano-db download latest"
cd "$DEST/.toolkit" || exit 1   # keeps ./config (mithril-client's default config dir) away from the node's config dir
set -o pipefail
"$CLIENT" --json --aggregator-endpoint "$AGG" \
  cardano-db download latest \
  --include-ancillary \
  --download-dir "$DEST" \
  --allow-override \
  </dev/null 2>&1 | tee -a "$LOG"
RC=${PIPESTATUS[0]}
snapdiag "download_done rc=$RC"
if [ "$RC" -ne 0 ]; then
  state error 0 "mithril-client cardano-db download failed rc=$RC - see $LOG"
  exit "$RC"
fi
if [ ! -d "$DB/immutable" ] || [ ! -d "$DB/ledger" ]; then
  snapdiag "ERROR $DB/immutable or $DB/ledger missing after download"
  state error 0 "db/immutable or db/ledger missing after download (ancillary not restored)"
  exit 1
fi
date -u +%Y-%m-%dT%H:%M:%SZ >"$MARKER"
state done 100 "Mithril snapshot ready"
snapdiag "DONE marker=$MARKER"
exit 0
