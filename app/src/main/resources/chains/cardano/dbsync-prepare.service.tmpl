[Unit]
Description={{description}}
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
# simple + RemainAfterExit: `systemctl restart` returns at once (the first run may install PostgreSQL), the unit stays
# active after the script has finished, and a crash is retried.
Type=simple
RemainAfterExit=yes
ExecStart={{exec_start}}
Restart=on-failure
RestartSec=60
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
