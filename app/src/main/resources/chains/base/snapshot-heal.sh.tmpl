#!/bin/bash
set -uo pipefail
export LC_ALL=C
ENV='{{env}}'
BIN='{{bin}}'
RETHDIR='{{reth_dir}}'
MARKER='{{marker}}'
STATE='{{state}}'
LOG='{{log}}'
FLAVOR='{{flavor}}'
CHAIN='{{chain}}'
NEED_GIB={{need_gib}}
MANIFEST_URL='{{manifest_url}}'
MODEFILE="$RETHDIR/.snapshot-mode"
NODE_UNIT="rpcnode-base-${ENV}.service"
CONS_UNIT="rpcnode-base-consensus-${ENV}.service"
mkdir -p "$(dirname "$LOG")" "$RETHDIR"
snapdiag() { echo "SNAPSHOT_DIAG $*" | tee -a "$LOG"; }
state() { printf '{"phase":"%s","pct":%s,"detail":"%s","flavor":"%s","updated_at":"%s"}\n' \
  "$1" "$2" "$3" "$FLAVOR" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STATE"; }
snapdiag "begin pid=$$ env=$ENV chain=$CHAIN flavor=$FLAVOR datadir=$RETHDIR"
trap 'snapdiag "ERR line=$LINENO cmd=$BASH_COMMAND rc=$?"' ERR
trap 'snapdiag "TERM rc=143 — interrupted, not done"; exit 143' TERM
systemctl stop "$CONS_UNIT" 2>/dev/null || true
systemctl stop "$NODE_UNIT" 2>/dev/null || true
if [ ! -x "$BIN" ] && ! command -v "$BIN" >/dev/null 2>&1; then
  snapdiag "ERROR base-reth-node missing at $BIN"
  state error 0 "base-reth-node missing at $BIN"
  exit 1
fi
FREE_GIB="$(df -B1G --output=avail "$RETHDIR" 2>/dev/null | tail -1 | tr -dc '0-9')"
USED_GIB="$(du -sBG "$RETHDIR" 2>/dev/null | awk '{print $1}' | tr -dc '0-9')"
: "${FREE_GIB:=0}" "${USED_GIB:=0}"
snapdiag "disk free=${FREE_GIB}GiB used=${USED_GIB}GiB need=${NEED_GIB}GiB"
if [ "$((FREE_GIB + USED_GIB))" -lt "$NEED_GIB" ]; then
  snapdiag "ERROR disk gate: ${FREE_GIB}GiB free + ${USED_GIB}GiB restored < ${NEED_GIB}GiB for $FLAVOR"
  state error 0 "not enough disk for the $FLAVOR snapshot (need ~${NEED_GIB} GiB, ${FREE_GIB} GiB free)"
  exit 1
fi
MODE=""
[ -f "$MODEFILE" ] && MODE="$(tr -d '[:space:]' <"$MODEFILE")"
if [ -z "$MODE" ]; then
  if [ -s "$RETHDIR/db/mdbx.dat" ] || [ -n "$(ls -A "$RETHDIR/static_files" 2>/dev/null)" ]; then
    MODE=migrate
  else
    MODE=download
  fi
  echo "$MODE" >"$MODEFILE"
fi
snapdiag "mode=$MODE"
if [ "$MODE" = migrate ]; then
  state migrate 0 "Base V1 → V2 storage migration"
  "$BIN" db --datadir "$RETHDIR" --chain "$CHAIN" migrate-v2 2>&1 | tee -a "$LOG"
  RC=${PIPESTATUS[0]}
  snapdiag "migrate_done rc=$RC"
  if [ "$RC" -ne 0 ]; then
    state error 0 "db migrate-v2 failed rc=$RC — see $LOG"
    exit "$RC"
  fi
  snapdiag "migrated $CHAIN"
else
  CONC="$(( $(nproc 2>/dev/null || echo 4) * 2 ))"
  [ "$CONC" -lt 8 ] && CONC=8
  [ "$CONC" -gt 32 ] && CONC=32
  state download 0 "Base V2 snapshot · $FLAVOR · resolving manifest"
  if [ -n "$MANIFEST_URL" ]; then
    snapdiag "download --manifest-url=$MANIFEST_URL"
    "$BIN" download --"$FLAVOR" --manifest-url "$MANIFEST_URL" --resumable --download-concurrency "$CONC" \
      --datadir "$RETHDIR" --chain "$CHAIN" 2>&1 | tee -a "$LOG"
  else
    "$BIN" download --"$FLAVOR" --resumable --download-concurrency "$CONC" \
      --datadir "$RETHDIR" --chain "$CHAIN" 2>&1 | tee -a "$LOG"
  fi
  RC=${PIPESTATUS[0]}
  snapdiag "download_done rc=$RC"
  if [ "$RC" -ne 0 ]; then
    state error 0 "base-reth-node download failed rc=$RC — see $LOG"
    exit "$RC"
  fi
  if [ -n "$(ls -A "$RETHDIR"/*.part 2>/dev/null)" ]; then
    snapdiag "ERROR rc=0 with .part segments still on disk — not done"
    state error 0 "snapshot ended with unfinished segments — re-run Snapshot (the download is idempotent)"
    exit 1
  fi
fi
if [ ! -s "$RETHDIR/db/mdbx.dat" ]; then
  snapdiag "ERROR no MDBX state under $RETHDIR"
  state error 0 "snapshot finished but $RETHDIR has no db/mdbx.dat — re-run Snapshot"
  exit 1
fi
if [ -z "$(ls -A "$RETHDIR/static_files" 2>/dev/null)" ] && [ -z "$(ls -A "$RETHDIR/rocksdb" 2>/dev/null)" ]; then
  snapdiag "ERROR state only, no segments/indices under $RETHDIR"
  state error 0 "snapshot finished but $RETHDIR has no segments — re-run Snapshot"
  exit 1
fi
date -u +"%Y-%m-%dT%H:%M:%SZ" >"$MARKER"
state done 100 "Base V2 snapshot ready · $FLAVOR"
snapdiag "DONE base $FLAVOR mode=$MODE"
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) DONE base $ENV $FLAVOR" | tee -a "$LOG"
