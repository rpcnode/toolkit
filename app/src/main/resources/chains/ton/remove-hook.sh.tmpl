#!/bin/bash
# Runs when the node is removed (stop first, then this, then the files). RPCNODE_REMOVE_WIPE=1 when the chain data is
# wiped too. Two parts:
#  1. the indexer: drops what rpcnode-ton-indexer.sh created in PostgreSQL — the database, its tablespace and the role —
#     and the tablespace directory. The PostgreSQL server itself (existing or installed by the indexer) stays; other
#     databases on it are not touched.
#  2. MyTonCtrl: stops and removes its services (validator, mytoncore, ton_http_api), its programs and sources.
#     Its user data (~/.local/share/mytoncore: wallet db) goes only with a wipe; the chain data stays unless wiped.
set -uo pipefail
PWDIR={{pw_dir}}
IDX={{idx_dir}}
WIPE="${RPCNODE_REMOVE_WIPE:-0}"

remove_mytonctrl() {
  local u
  for u in ton_http_api.service ton-http-api.service mytoncore.service validator.service; do
    systemctl disable --now "$u" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/$u" "/etc/systemd/system/multi-user.target.wants/$u"
    rm -rf "/etc/systemd/system/$u.d"
    systemctl reset-failed "$u" >/dev/null 2>&1 || true
  done
  rm -f /etc/sysctl.d/99-rpcnode-ton.conf
  systemctl daemon-reload >/dev/null 2>&1 || true
  rm -rf /usr/bin/ton /usr/src/ton /usr/src/mytonctrl /usr/local/bin/mytoncore /usr/local/bin/mytonctrl
  # only the link: the chain data it points to is wiped (or kept) by the panel, never here
  if [[ -L /var/ton-work ]]; then rm -f /var/ton-work; fi
  if [[ "$WIPE" == 1 ]]; then rm -rf /root/.local/share/mytoncore /root/.local/share/mytonctrl; fi
  echo "removed MyTonCtrl services and programs (validator, mytoncore, ton_http_api, /usr/bin/ton, /usr/src/ton, /usr/src/mytonctrl)"
}

if [[ ! -f "$PWDIR/pg.env" ]]; then
  echo "the indexer database was never created — nothing to drop"
  remove_mytonctrl
  exit 0
fi
# shellcheck disable=SC1091
. "$PWDIR/pg.env"

psql_su() { ( cd / && setpriv --reuid=postgres --regid=postgres --init-groups psql -p "$PG_PORT" -X -q -At -v ON_ERROR_STOP=1 "$@" ); }

if ! psql_su -d postgres -c 'select 1' >/dev/null 2>&1; then
  systemctl start postgresql >/dev/null 2>&1 || true
  sleep 5
fi
if ! psql_su -d postgres -c 'select 1' >/dev/null 2>&1; then
  echo "PostgreSQL is not reachable on port $PG_PORT — database $PG_DB, tablespace $PG_TS and role $PG_ROLE were NOT dropped"
  remove_mytonctrl
  exit 0
fi

# the indexer processes are already stopped; close whatever else is still connected
psql_su -d postgres -c "select pg_terminate_backend(pid) from pg_stat_activity where datname = '$PG_DB' and pid <> pg_backend_pid()" >/dev/null 2>&1 || true
psql_su -d postgres -c "drop database if exists $PG_DB" || exit 1
psql_su -d postgres -c "drop tablespace if exists $PG_TS" || exit 1
psql_su -d postgres -c "drop role if exists $PG_ROLE" || exit 1

# the tablespace directory is the indexer's own (inside its directory); keep anything that is not
if [[ -n "$PG_TS_DIR" && "$PG_TS_DIR" == "$IDX"/* ]]; then rm -rf "$PG_TS_DIR"; fi
rm -f "$PWDIR/pg.env" "$PWDIR/pgpass" "$PWDIR/postgres_password" "$PWDIR/pg-tuned"
echo "dropped database $PG_DB, tablespace $PG_TS and role $PG_ROLE (PostgreSQL port $PG_PORT)"
remove_mytonctrl
