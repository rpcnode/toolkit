#!/bin/bash
# RpcNode Toncoin bootstrap — MyTonCtrl liteserver ({{install_mode}}).
set -euo pipefail
ENV={{env}}
CHAIN={{chain}}
P2P={{p2p}}
THA_PORT={{tha_port}}
DATA={{data}}
MARKER_DIR={{marker_dir}}
LOG_DIR={{log_dir}}
MARKER="$MARKER_DIR/bootstrap.done"
LOG="$LOG_DIR/bootstrap.log"
ARCHIVE_TTL={{archive_ttl}}
STATE_TTL={{state_ttl}}
NOFILE={{nofile}}
NR_OPEN={{nr_open}}
INSTALL_URL={{install_url}}
INSTALL_EXTRA={{install_extra}}
GLOBAL_CONFIG_URL={{global_config_url}}
ZERO_STATE={{zero_state_hash}}

wait_apt_lock() {
  local deadline=$((SECONDS + 900))
  while true; do
    local busy=0
    if pgrep -x apt-get >/dev/null 2>&1 \
       || pgrep -x apt >/dev/null 2>&1 \
       || pgrep -x dpkg >/dev/null 2>&1; then
      busy=1
    elif fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 \
       || fuser /var/lib/dpkg/lock >/dev/null 2>&1 \
       || fuser /var/lib/apt/lists/lock >/dev/null 2>&1 \
       || fuser /var/cache/apt/archives/lock >/dev/null 2>&1; then
      busy=1
    fi
    if [[ $busy -eq 0 ]]; then
      return 0
    fi
    if (( SECONDS >= deadline )); then
      echo "timeout waiting for apt/dpkg lock (900s) — continuing anyway" >&2
      return 0
    fi
    echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] waiting for apt/dpkg lock..."
    sleep 15
  done
}

disable_broken_apt_release_sources() {
  local err urc f host
  set +e
  err="$(apt-get update -y 2>&1)"
  urc=$?
  set -e
  printf '%s\n' "$err"
  if [[ $urc -eq 0 ]] || ! printf '%s\n' "$err" | grep -qi 'does not have a Release file'; then
    return 0
  fi
  echo "disabling apt lists that 404 (no Release file)"
  for f in /etc/apt/sources.list.d/*.list; do
    [[ -f "$f" ]] || continue
    if printf '%s\n' "$err" | grep -qiE 'ookla|speedtest-cli' && grep -qiE 'ookla|speedtest-cli' "$f"; then
      echo "disable $f"
      mv -f "$f" "${f}.rpcnode-disabled"
      continue
    fi
    while IFS= read -r host; do
      [[ -n "$host" ]] || continue
      if grep -q "$host" "$f"; then
        echo "disable $f (host $host)"
        mv -f "$f" "${f}.rpcnode-disabled"
        break
      fi
    done < <(printf '%s\n' "$err" | grep -E '^Err:[0-9]+' | grep -oE 'https://[^/]+' | sed 's|https://||' | sort -u)
  done
  apt-get update -y || true
}

mkdir -p "$DATA" "$MARKER_DIR" "$LOG_DIR"
mkdir -p /etc/systemd/system/validator.service.d
cat >/etc/systemd/system/validator.service.d/rpcnode-nofile.conf <<EOF
[Service]
LimitNOFILE=$NOFILE
EOF
echo "fs.nr_open = $NR_OPEN" >/etc/sysctl.d/99-rpcnode-ton.conf
sysctl -w "fs.nr_open=$NR_OPEN" >/dev/null 2>&1 || true
systemctl daemon-reload || true
exec >>"$LOG" 2>&1
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] ton bootstrap start env=$ENV chain=$CHAIN"

if [[ -f "$MARKER" ]]; then
  echo "bootstrap already done"
  exit 0
fi

if [[ -L /var/ton-work ]]; then
  tgt="$(readlink /var/ton-work || true)"
  if [[ ! -e "$tgt" ]]; then
    rm -f /var/ton-work
    ln -sfn "$DATA" /var/ton-work
  fi
elif [[ ! -e /var/ton-work ]]; then
  ln -sfn "$DATA" /var/ton-work
elif [[ -d /var/ton-work ]] && [[ ! -f /var/ton-work/keys/client ]] && [[ ! -f /var/ton-work/db/config.json ]]; then
  rm -rf /var/ton-work
  ln -sfn "$DATA" /var/ton-work
fi

export DEBIAN_FRONTEND=noninteractive
export HOME="${HOME:-/root}"
# MyTonCtrl pins fastcrc==0.3.2 (PyO3 0.22), which has no wheel and refuses to build on Python 3.13+ (Ubuntu 25.10+/26.04
# ship 3.14: "configured Python interpreter version (3.14) is newer than PyO3's maximum supported version").
# The stable-ABI switch lets the same release build anyway; it is harmless on older Python.
export PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1
export DEBIAN_FRONTEND=noninteractive
export HOME="${HOME:-/root}"
export USER="${USER:-root}"
if ! command -v apt-get >/dev/null 2>&1; then
  echo "ERROR: TON/MyTonCtrl bootstrap is Debian/Ubuntu-only (apt-get required)." >&2
  exit 1
fi
wait_apt_lock
disable_broken_apt_release_sources
wait_apt_lock
apt-get install -y curl wget git ca-certificates python3-pip || true

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
if ! curl -fsSL --connect-timeout 30 --max-time 180 --retry 8 --retry-delay 3 --retry-all-errors --retry-connrefused "$INSTALL_URL" -o "$TMP/install.sh"; then
  echo "ERROR: download install.sh failed" >&2
  exit 1
fi
chmod +x "$TMP/install.sh"

# install.sh pip-installs MyTonCtrl and clones it from GitHub. When PyPI is not reachable (DNS, firewall, proxy, a pip
# mirror without the package) it only fails at the very end with "No matching distribution found for setuptools>=64" —
# check the network first and say so. Pip itself gets patient timeouts for a slow link.
export PIP_DEFAULT_TIMEOUT="${PIP_DEFAULT_TIMEOUT:-60}"
export PIP_RETRIES="${PIP_RETRIES:-10}"
echo "pip/proxy env: $(env | grep -iE '^(PIP_|https?_proxy|all_proxy|no_proxy)' | tr '\n' ' ')"
reachable() {
  local code
  code="$(curl -sS -o /dev/null -m 25 --retry 2 --retry-delay 3 -w '%{http_code}' "$1" 2>/dev/null)" || return 1
  [[ "$code" =~ ^[234][0-9][0-9]$ ]]
}
for url in https://pypi.org/simple/setuptools/ https://files.pythonhosted.org/ https://github.com/ton-blockchain/mytonctrl; do
  if ! reachable "$url"; then
    echo "ERROR: cannot reach $url from this host (DNS / firewall / proxy) — MyTonCtrl needs PyPI and GitHub" >&2
    exit 1
  fi
done

# MyTonCtrl's install_clang.sh only knows Ubuntu 22.04/24.04/26.04 and Debian 12 (by `lsb_release -cs`) and exits with
# "Unsupported distribution" on everything else (Linux Mint, LMDE, Pop!_OS, Debian 13, non-LTS Ubuntu ...). The node
# wizard installs clang-21 in its host-deps step; this is the safety net for a start without it: on such a system get
# clang 21 from the LLVM repo of the base release — install_clang.sh skips its own step when clang is already 21.
{{clang_functions}}
prepare_clang_for_unknown_distro() {
  case "$(lsb_release -cs 2>/dev/null || true)" in jammy|noble|resolute|bookworm) return 0 ;; esac
  wait_apt_lock || true
  ensure_clang_major 21
}
prepare_clang_for_unknown_distro || echo "clang-21 pre-install failed — install.sh will report the details"

# install.sh fetches the network's global config only when it builds the node. A host that already has TON binaries
# (an older mainnet install, units, /usr/bin/ton) keeps its old global.config.json, and `-n testnet` then runs the
# validator — and downloads the dump — of the OTHER network. Compare the zero state and fix the config first.
ensure_global_config() {
  local cfg=/usr/bin/ton/global.config.json have got
  [[ -f "$cfg" ]] || return 0
  have="$(python3 - "$cfg" <<'PY' 2>/dev/null
import base64, json, sys
try:
    print(base64.b64decode(json.load(open(sys.argv[1]))["validator"]["zero_state"]["root_hash"]).hex().upper())
except Exception:
    pass
PY
)"
  [[ "$have" == "$ZERO_STATE" ]] && return 0
  echo "global.config.json is for another network (zero state ${have:-unreadable}, wanted $ZERO_STATE)"
  if [[ -d "$DATA/db" && -n "$(ls -A "$DATA/db" 2>/dev/null)" ]]; then
    echo "ERROR: $DATA/db already holds data of another network — wipe it (remove the node with its data) before installing $CHAIN" >&2
    return 2   # exit 2 = the unit does not restart (RestartPreventExitStatus=2): retrying cannot fix this
  fi
  curl -fsSL --connect-timeout 30 --max-time 120 --retry 5 --retry-all-errors "$GLOBAL_CONFIG_URL" -o "$TMP/global.config.json" \
    || { echo "ERROR: download of $GLOBAL_CONFIG_URL failed" >&2; return 1; }
  got="$(python3 - "$TMP/global.config.json" <<'PY' 2>/dev/null
import base64, json, sys
try:
    print(base64.b64decode(json.load(open(sys.argv[1]))["validator"]["zero_state"]["root_hash"]).hex().upper())
except Exception:
    pass
PY
)"
  if [[ "$got" != "$ZERO_STATE" ]]; then
    echo "ERROR: $GLOBAL_CONFIG_URL has zero state ${got:-unreadable}, expected $ZERO_STATE" >&2
    return 2
  fi
  cp -a "$cfg" "$cfg.bak-$(date +%s)"
  install -m 644 "$TMP/global.config.json" "$cfg"
  echo "global.config.json replaced with the $CHAIN config (old one kept as $cfg.bak-*)"
}
cfg_rc=0
ensure_global_config || cfg_rc=$?
(( cfg_rc == 0 )) || exit "$cfg_rc"

export ARCHIVE_TTL STATE_TTL
export VALIDATOR_PORT="$P2P"
rc=1
attempt=1
while (( attempt <= 5 )); do
  wait_apt_lock || true
  set +e
  env HOME="$HOME" USER="$USER" bash "$TMP/install.sh" -m liteserver -n "$CHAIN" $INSTALL_EXTRA
  rc=$?
  set -e
  echo "install.sh attempt=$attempt exit=$rc extra=$INSTALL_EXTRA"
  if [[ $rc -eq 0 ]]; then
    break
  fi
  if grep -qi 'does not have a Release file' "$LOG" 2>/dev/null; then
    echo "apt repo 404 (no Release file) — not a dpkg lock"
    disable_broken_apt_release_sources
    if [[ "${HEALED_APT:-0}" -eq 0 ]]; then
      HEALED_APT=1
      attempt=$((attempt + 1))
      continue
    fi
    echo "apt still broken after disabling 404 sources — exit 2 (no restart loop)"
    exit 2
  fi
  if grep -qiE 'Could not get lock /var/lib/dpkg|Unable to acquire the dpkg frontend lock' "$LOG" 2>/dev/null; then
    echo "apt/dpkg lock — retry in 60s (attempt $attempt/5)"
    sleep 60
    attempt=$((attempt + 1))
    continue
  fi
  if [[ $rc -eq 128 ]] && grep -qi 'HOME not set' "$LOG" 2>/dev/null; then
    export HOME=/root
    echo "retry install.sh with HOME=/root (attempt $attempt/5)"
    sleep 5
    attempt=$((attempt + 1))
    continue
  fi
  break
done
echo "install.sh exit=$rc"

MTC_PY=/usr/local/bin/mytoncore/venv/bin/python
MTC_DB=/usr/local/bin/mytoncore/mytoncore.db
if [[ -x "$MTC_PY" && -f "$MTC_DB" ]]; then
  "$MTC_PY" -m mytonctrl -c "$MTC_DB" --cmd "installer clcf" || true
  "$MTC_PY" -m mytonctrl -c "$MTC_DB" --cmd "installer enable THA" || true
fi

for tha_unit in ton_http_api ton-http-api; do
  mkdir -p "/etc/systemd/system/${tha_unit}.service.d"
  cat >"/etc/systemd/system/${tha_unit}.service.d/rpcnode.conf" <<EOF
[Service]
Environment=TON_API_HTTP_PORT=$THA_PORT
Environment=TON_API_PORT=$THA_PORT
LimitNOFILE=1048576
EOF
done
if [[ -f /etc/systemd/system/ton_http_api.service ]]; then
  # An existing unit keeps the port of whatever install made it (8801 default, 8081 mainnet, ...): take any --port,
  # otherwise the API listens elsewhere than the catalog port and the panel never sees the height.
  sed -i -E "s/--port [0-9]+/--port $THA_PORT/g" /etc/systemd/system/ton_http_api.service || true
  # MyTonCtrl binds the API to 127.0.0.1 (only the host itself can call it). The node page lists it as the node's
  # endpoint, so listen on all interfaces; firewall the port (ufw: allow it only from your IPs). To keep it local set
  # RPCNODE_TON_API_BIND=127.0.0.1 in /etc/rpcnode/ton.env (read by the bootstrap unit), or change `--host` in
  # /etc/systemd/system/ton_http_api.service by hand (then `systemctl daemon-reload && systemctl restart ton_http_api`).
  sed -i -E "s/--host [0-9a-fA-F.:]+/--host ${RPCNODE_TON_API_BIND:-0.0.0.0}/g" /etc/systemd/system/ton_http_api.service || true
  ln -sfn /etc/systemd/system/ton_http_api.service /etc/systemd/system/ton-http-api.service || true
fi
systemctl daemon-reload || true

mkdir -p /etc/systemd/system/validator.service.d
cat >/etc/systemd/system/validator.service.d/rpcnode.conf <<EOF
[Service]
IPAccounting=yes
CPUAccounting=yes
MemoryAccounting=yes
LimitNOFILE=$NOFILE
EOF
systemctl daemon-reload || true

if [[ -f /etc/systemd/system/validator.service ]]; then
  python3 - <<'PY' || true
import re
path = "/etc/systemd/system/validator.service"
try:
    text = open(path).read()
except OSError:
    raise SystemExit(0)
mem = 0
for line in open("/proc/meminfo"):
    if line.startswith("MemTotal:"):
        mem = int(line.split()[1]) // 1024
        break
gib = mem / 1024
if gib < 16:
    cache = 1 << 30
elif gib < 32:
    cache = 2 << 30
elif gib < 64:
    cache = 4 << 30
else:
    cache = 8 << 30
m = re.search(r"(?m)^ExecStart\s*=\s*(.+)$", text)
if not m or "validator-engine" not in m.group(1):
    raise SystemExit(0)
line = m.group(1).strip()
line = re.sub(r"\s+--celldb-cache-size(?:=|\s+)\S+", "", line)
line = re.sub(r"\s+--celldb-preload-all\b", "", line)
line = re.sub(r"\s+--celldb-in-memory\b", "", line)
line = re.sub(r"\s+--celldb-direct-io\b", "", line)
line = re.sub(r"\s+--fast-state-serializer\b", "", line)
flag = f"--celldb-cache-size={cache}"
if flag not in line:
    line = line.strip() + " " + flag
new = re.sub(r"(?m)^ExecStart\s*=\s*.+$", "ExecStart=" + line, text, count=1)
if new != text:
    open(path, "w").write(new)
    print(f"capped celldb cache at {cache} bytes (RAM ~{gib:.0f} GiB)")
PY
  systemctl daemon-reload || true
fi

systemctl enable validator.service mytoncore.service 2>/dev/null || true
systemctl restart validator.service 2>/dev/null || true
systemctl restart mytoncore.service 2>/dev/null || true
for u in ton_http_api.service ton-http-api.service; do
  systemctl enable "$u" 2>/dev/null || true
  systemctl restart "$u" 2>/dev/null || true
done

VE_BIN=""
for c in /usr/bin/ton/validator-engine/validator-engine /usr/bin/ton/validator-engine; do
  if [[ -x "$c" && ! -d "$c" ]]; then VE_BIN="$c"; break; fi
done
if [[ -n "$VE_BIN" ]] && systemctl cat validator.service >/dev/null 2>&1; then
  date -u +%Y-%m-%dT%H:%M:%SZ >"$MARKER"
  echo "bootstrap marker written ($VE_BIN)"
  exit 0
fi

if [[ $rc -ne 0 ]]; then
  # The panel shows logs/ton.log; the reason lives in the much longer bootstrap.log — surface it there.
  # Read it before printing our own "bootstrap failed" line (stderr goes to $LOG), and skip earlier ones of that kind,
  # otherwise the "reason" is just the previous failure line again.
  reason="$(grep -aE "error:|ERROR|Error:|E: |fatal|Traceback|No such file|not found|failed" "$LOG" 2>/dev/null \
    | grep -avE "^[[:space:]]*(warning|note)|bootstrap (failed|FAILED)" | tail -n 1 | cut -c1-240)"
  echo "bootstrap failed rc=$rc" >&2
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] bootstrap FAILED rc=$rc: ${reason:-see logs/bootstrap.log} (retry in 60s)" >>"$LOG_DIR/ton.log" 2>/dev/null || true
  exit $rc
fi
date -u +%Y-%m-%dT%H:%M:%SZ >"$MARKER"
echo "bootstrap finished"
