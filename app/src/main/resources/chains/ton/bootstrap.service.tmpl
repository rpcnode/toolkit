[Unit]
Description={{description}}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
Environment=USER=root
# optional overrides, e.g. RPCNODE_TON_API_BIND=127.0.0.1 (the TON HTTP API listens on all interfaces by default)
EnvironmentFile=-/etc/rpcnode/ton.env
ExecStart={{exec_start}}
TimeoutStartSec=0
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=60
Nice=10
LimitNOFILE={{nofile}}

[Install]
WantedBy=multi-user.target
