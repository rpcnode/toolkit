#!/bin/bash
set -euo pipefail
MARKER={{marker}}
BOOT_UNIT={{bootstrap_unit}}
LOG={{log_file}}
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1

# The MyTonCtrl install writes its (long) output to bootstrap.log next to this log; the panel only shows this one.
# While waiting, copy what is new there — the ninja compile counter is thinned to every 100th step.
BOOT_LOG="$(dirname "$LOG")/bootstrap.log"
BOOT_OFF=0
mirror_bootstrap_log() {
  [[ -f "$BOOT_LOG" ]] || return 0
  local size
  size="$(stat -c%s "$BOOT_LOG" 2>/dev/null || echo 0)"
  if (( size < BOOT_OFF )); then BOOT_OFF=0; fi
  if (( size > BOOT_OFF )); then
    tail -c +$((BOOT_OFF + 1)) "$BOOT_LOG" | head -c $((size - BOOT_OFF)) | tr -d '\r' | awk '
      /^\[[0-9]+\/[0-9]+\] / {
        split($1, p, /[\[\/\]]/)
        if (p[3] > 50 && (p[2] % 100) != 0 && p[2] != p[3]) next
      }
      { print "[bootstrap] " $0 }'
    BOOT_OFF=$size
  fi
  return 0
}

if [[ ! -f "$MARKER" ]]; then
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] bootstrap marker missing — starting $BOOT_UNIT (details: $BOOT_LOG)"
  BOOT_OFF="$(stat -c%s "$BOOT_LOG" 2>/dev/null || echo 0)"
  systemctl start --no-block "$BOOT_UNIT" || true
  while [[ ! -f "$MARKER" ]]; do
    mirror_bootstrap_log
    if systemctl is-failed "$BOOT_UNIT" >/dev/null 2>&1; then
      mirror_bootstrap_log
      echo "bootstrap unit failed" >&2
      exit 1
    fi
    sleep 5
  done
  mirror_bootstrap_log
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] bootstrap done"
fi

systemctl start --no-block validator.service mytoncore.service 2>/dev/null || true
for u in ton-http-api.service ton_http_api.service; do
  systemctl start --no-block "$u" 2>/dev/null || true
done

# Keep MainPID alive for HostNodeLaunchSupport.waitActive — stock daemons are separate units.
exec sleep infinity
