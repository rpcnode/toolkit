# syntax=docker/dockerfile:1
# Builds op-node from the ethereum-optimism/optimism monorepo at TAG (e.g. op-node/v1.19.9) for `clients.yml` → build.
# GO_VERSION is the monorepo's go.mod toolchain at that tag and must equal OptimismUnitBodies.GO_VERSION.
FROM ubuntu:22.04 AS build
ARG VERSION
ARG TAG
ARG GO_VERSION=1.26.6
ARG TARGETARCH
LABEL org.opencontainers.image.version=$VERSION
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends build-essential git curl ca-certificates jq zip \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" | tar -C /usr/local -xz
# op-node embeds superchain-configs.zip, generated by the repository from the superchain-registry submodule with yq/jq/zip.
RUN curl -fsSL -o /usr/local/bin/yq "https://github.com/mikefarah/yq/releases/download/v4.44.5/yq_linux_${TARGETARCH}" \
 && chmod 755 /usr/local/bin/yq
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=auto CGO_ENABLED=0

RUN git clone --depth 1 --branch "$TAG" https://github.com/ethereum-optimism/optimism.git /src \
 && git -C /src submodule update --init --depth 1 superchain-registry
WORKDIR /src
RUN bash op-core/superchain/sync-superchain.sh
RUN go build -o /out/op-node -ldflags "-X github.com/ethereum-optimism/optimism/op-node/version.Version=${TAG##*/}" ./op-node/cmd

FROM scratch
COPY --from=build /out/op-node /op-node
