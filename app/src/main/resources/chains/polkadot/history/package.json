  },
  "dependencies": {
    "@subsquid/big-decimal": "1.0.0",
    "@subsquid/graphql-server": "4.12.1",
    "@subsquid/ss58": "2.0.2",
    "@subsquid/substrate-processor": "8.8.2",
    "@subsquid/typeorm-migration": "1.4.0",
    "@subsquid/typeorm-store": "1.9.2",
    "pg": "8.23.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
