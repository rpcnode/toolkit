#!/bin/bash
# Arc snapshot restore (arc-snapshots download) for the wizard's Snapshot step. Writes {{state}} for the panel and the
# marker the node's run script also checks, so Start does not download it again.
set -uo pipefail
export LC_ALL=C
ENV='{{env}}'
CHAIN='{{chain}}'
KIND='{{kind}}'
TOOL='{{tool}}'
EXEC='{{exec}}'
CONS='{{cons}}'
MARKER='{{marker}}'
STATE='{{state}}'
LOG='{{log}}'
NODE_UNIT="rpcnode-arc-${ENV}.service"
mkdir -p "$(dirname "$LOG")" "$(dirname "$MARKER")" "$EXEC" "$CONS"
snapdiag() { echo "SNAPSHOT_DIAG $*" | tee -a "$LOG"; }
state() { printf '{"phase":"%s","pct":%s,"detail":"%s","updated_at":"%s"}\n' \
  "$1" "$2" "$3" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$STATE"; }
snapdiag "begin pid=$$ env=$ENV kind=$KIND exec=$EXEC cons=$CONS"
trap 'snapdiag "TERM rc=143 — interrupted, not done"; exit 143' TERM
if [ -f "$MARKER" ]; then
  state done 100 "Snapshot already restored"
  exit 0
fi
if [ ! -x "$TOOL" ]; then
  snapdiag "ERROR arc-snapshots missing at $TOOL"
  state error 0 "arc-snapshots missing at $TOOL — sync Arc clients first"
  exit 1
fi
# arc-snapshots runs arc-node-execution itself (storage v2 manifests); it ships next to the tool, not on PATH
BIN_DIR="$(dirname "$TOOL")"
export PATH="$BIN_DIR:$PATH"
export ARC_EXECUTION_BINARY="$BIN_DIR/arc-node-execution"
if [ ! -x "$ARC_EXECUTION_BINARY" ]; then
  snapdiag "ERROR arc-node-execution missing at $ARC_EXECUTION_BINARY"
  state error 0 "arc-node-execution missing at $ARC_EXECUTION_BINARY — sync Arc clients first"
  exit 1
fi
# nothing may write into the two directories while the tool restores them
systemctl stop "$NODE_UNIT" 2>/dev/null || true
args=(download --chain "$CHAIN" --execution-path "$EXEC" --consensus-path "$CONS")
[ "$KIND" = archive ] && args+=(--el-profile archive)
state download 0 "Arc snapshot · $CHAIN · $KIND · resolving…"
set -o pipefail
"$TOOL" "${args[@]}" 2>&1 | tee -a "$LOG"
RC=${PIPESTATUS[0]}
snapdiag "download_done rc=$RC"
if [ "$RC" -ne 0 ]; then
  state error 0 "arc-snapshots download failed rc=$RC — see $LOG"
  exit "$RC"
fi
touch "$MARKER"
state done 100 "Snapshot restored"
snapdiag "DONE marker=$MARKER"
exit 0
