#!/bin/bash
# RpcNode OP Stack node ({{net_id}}): one run script for every network of the opstack family (Unichain, Ink, Soneium, World Chain,
# Lisk, Mode, Zora). It uses the execution client the panel synced for this CPU (op-reth: $ROOT/op-reth-<arch>, a prebuilt compiled
# on the panel's build hosts; world-chain: $ROOT/world-chain-<arch>.tar.gz, the project's release tarball), otherwise builds op-reth from
# the pinned monorepo tag; the same for op-node. It restores a datadir snapshot once (when the network has a source or the operator gave
# a snapshot_url), then runs the EL and op-node as two supervised processes — the execution layer first: op-node talks to its Engine API.
# Everything lives under node_dir. Written 0700: it holds the L1 endpoint (may carry an API key) and the operator's snapshot URL.
set -uo pipefail
NET={{net_id}}
ENV_ID={{env}}
MODE={{mode}}
EL_FLAVOR={{el_flavor}}
EL_BIN_NAME={{el_bin_name}}
RETH_CHAIN={{reth_chain}}
NODE_NETWORK={{node_network}}
SEQUENCER={{sequencer}}
SYNC_MODE={{sync_mode}}
SNAP_WANTED={{snapshot_wanted}}
SNAP_KIND={{snap_kind}}
SNAP_REF={{snap_ref}}
SNAP_PATH={{snap_path}}
SNAP_URL_FULL={{snap_url_full}}
SNAP_URL_ARCHIVE={{snap_url_archive}}
SNAP_CUSTOM={{snap_custom_url}}
ROOT={{node_dir}}
EXEC={{exec_dir}}
CONS={{cons_dir}}
SNAPS={{snap_dir}}
STATE={{state_dir}}
LOG={{log_file}}
L1_RPC={{l1_rpc}}
L1_BEACON={{l1_beacon}}
HTTP_ADDR={{http_addr}}
LOOPBACK={{loopback}}
HTTP_PORT={{http_port}}
WS_PORT={{ws_port}}
ENGINE_PORT={{engine_port}}
METRICS_PORT={{metrics_port}}
P2P_PORT={{p2p_port}}
V5_PORT={{discv5_port}}
CL_RPC={{cl_rpc}}
CL_METRICS={{cl_metrics}}
CL_P2P={{cl_p2p}}
HTTP_API={{http_api}}
PRUNE_DISTANCE={{prune_distance}}
L1_CONFS={{l1_confs}}
CL_STATIC={{cl_static}}
CL_BOOTNODES={{cl_bootnodes}}
EL_TRUSTED={{el_trusted}}
EL_EXTRA={{el_extra_flags}}
RETH_TAG="${RPCNODE_OP_RETH_TAG:-{{reth_tag}}}"
NODE_TAG="${RPCNODE_OP_NODE_TAG:-{{node_tag}}}"
GO_VERSION="${RPCNODE_OP_GO:-{{go_version}}}"
BIN="$ROOT/bin"; SRC="$ROOT/src"; TOOLS="$ROOT/tools"; JWT="$STATE/jwt.hex"
mkdir -p "$(dirname "$LOG")" "$STATE" "$EXEC" "$CONS" "$SNAPS" "$BIN" "$TOOLS"
exec >>"$LOG" 2>&1

# Operator flag overrides (Node config → Flag overrides): $ROOT/.toolkit/extra_flags, one key=value per line, already
# validated by the panel host. A flag the array already has is replaced (clap rejects duplicates), a new one is appended.
EXTRA_FLAGS_FILE="$ROOT/.toolkit/extra_flags"
apply_extra_flags() {
  local -n _arr=$1
  [[ -s "$EXTRA_FLAGS_FILE" ]] || return 0
  local _line _key _val _new _x _i
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    [[ -z "$_line" || "$_line" == \#* ]] && continue
    _key="${_line%%=*}"; _val=""
    [[ "$_line" == *=* ]] && _val="${_line#*=}"
    [[ "$_key" =~ ^[a-z][a-z0-9._-]*$ ]] || continue
    _new=()
    for ((_i = 0; _i < ${#_arr[@]}; _i++)); do
      _x="${_arr[_i]}"
      if [[ "$_x" == "--$_key" ]]; then
        if ((_i + 1 < ${#_arr[@]})) && [[ "${_arr[_i + 1]}" != -* ]]; then ((_i++)); fi
        continue
      fi
      [[ "$_x" == "--$_key="* ]] && continue
      _new+=("$_x")
    done
    _arr=("${_new[@]}")
    if [[ -n "$_val" ]]; then _arr+=("--$_key=$_val"); else _arr+=("--$_key"); fi
  done <"$EXTRA_FLAGS_FILE"
}

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [$NET] $*"; }
RETH_PID=""; NODE_PID=""

stop_all() {
  log "stopping"
  [[ -n "$NODE_PID" ]] && kill -TERM "$NODE_PID" 2>/dev/null
  for _ in $(seq 1 60); do kill -0 "$NODE_PID" 2>/dev/null || break; sleep 1; done
  [[ -n "$RETH_PID" ]] && kill -TERM "$RETH_PID" 2>/dev/null
  for _ in $(seq 1 240); do kill -0 "$RETH_PID" 2>/dev/null || break; sleep 1; done
  kill -KILL "$NODE_PID" "$RETH_PID" 2>/dev/null || true
}
trap 'stop_all; exit 0' TERM INT

# --- 1. binaries ---------------------------------------------------------------------------------------------------------
install_packages() {
  [[ -f "$STATE/apt-v3.done" ]] && return 0
  command -v apt-get >/dev/null 2>&1 || { log "apt-get not found — Debian/Ubuntu only"; return 1; }
  log "installing build + restore tools"
  DEBIAN_FRONTEND=noninteractive apt-get update -y && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential clang libclang-dev pkg-config git curl ca-certificates openssl zstd lz4 aria2 xz-utils jq zip || return 1
  touch "$STATE/apt-v3.done"
}

install_go() {
  [[ -x "$TOOLS/go/bin/go" ]] && return 0
  local arch
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) log "unsupported CPU $(uname -m)"; return 1 ;; esac
  log "installing Go $GO_VERSION"
  curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" | tar -C "$TOOLS" -xz
}

# op-node embeds op-core/superchain/superchain-configs.zip, which the repository generates (sync-superchain.sh) from the
# superchain-registry submodule with yq (mikefarah, the version of the repository's mise.toml), jq and zip.
install_yq() {
  [[ -x "$TOOLS/bin/yq" ]] && return 0
  local arch
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) log "unsupported CPU $(uname -m)"; return 1 ;; esac
  log "installing yq 4.44.5"
  mkdir -p "$TOOLS/bin"
  curl -fsSL -o "$TOOLS/bin/yq.part" "https://github.com/mikefarah/yq/releases/download/v4.44.5/yq_linux_${arch}" \
    && chmod 755 "$TOOLS/bin/yq.part" && mv "$TOOLS/bin/yq.part" "$TOOLS/bin/yq"
}

install_rust() {
  export RUSTUP_HOME="$TOOLS/rustup" CARGO_HOME="$TOOLS/cargo"
  [[ -x "$CARGO_HOME/bin/rustup" ]] && return 0
  log "installing rustup (the toolchain version comes from the repository's rust-toolchain.toml)"
  curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none --no-modify-path
}

clone_tag() { # $1 = tag, $2 = dir, $3 = optional submodule path to init (superchain-registry: op-reth chainspec + op-node zip)
  if [[ ! -d "$2/.git" ]]; then
    rm -rf "$2"
    git clone --depth 1 --branch "$1" https://github.com/ethereum-optimism/optimism.git "$2" || { rm -rf "$2"; return 1; }
  fi
  # also runs on an existing checkout, so a clone made before submodules were fetched gets repaired on the next retry
  [[ -n "${3:-}" ]] && { git -C "$2" submodule update --init --depth 1 "$3" || return 1; }
  return 0
}

# Prebuilt by the panel's build hosts and synced with the client (`<name>-<arch>`); used when it runs here (an older glibc would refuse it).
use_prebuilt() { # $1 = op-reth | op-node
  local src="$ROOT/$1-$(uname -m)"
  [[ -f "$src" ]] || return 1
  chmod 755 "$src" 2>/dev/null
  "$src" --version >/dev/null 2>&1 || { log "prebuilt $(basename "$src") does not run on this host — building from source"; return 1; }
  if ! cmp -s "$src" "$BIN/$1"; then
    install -m 755 "$src" "$BIN/$1.new" && mv -f "$BIN/$1.new" "$BIN/$1" || return 1
  fi
  log "using the prebuilt $(basename "$src")"
  return 0
}

# World Chain flavour: the GitHub release tarball synced as world-chain-<arch>.tar.gz (one file inside: world-chain).
use_release_tar() { # $1 = binary name inside the tarball
  local tgz="$ROOT/$1-$(uname -m).tar.gz"
  [[ -f "$tgz" ]] || { log "$1 release tarball $(basename "$tgz") not synced yet — sync the clients of this node"; return 1; }
  if [[ ! -x "$BIN/$1" || "$tgz" -nt "$BIN/$1" ]]; then
    tar -xzf "$tgz" -C "$BIN" "$1" && chmod 755 "$BIN/$1" || return 1
  fi
  "$BIN/$1" --version >/dev/null 2>&1 || { log "$1 from the release tarball does not run on this host"; return 1; }
  log "using the release $1"
  return 0
}

build_reth() {
  use_prebuilt op-reth && return 0
  [[ -f "$STATE/built-op-reth-${RETH_TAG//\//_}" && -x "$BIN/op-reth" ]] && return 0
  clone_tag "$RETH_TAG" "$SRC/op-reth" superchain-registry || return 1
  [[ -e "$SRC/op-reth/superchain-registry/.git" ]] || { log "superchain-registry submodule missing after checkout"; return 1; }
  local ram_gb jobs
  ram_gb=$(awk '/MemTotal/ { printf "%d", $2 / 1048576 }' /proc/meminfo)
  jobs=$(( ram_gb / 3 )); (( jobs < 1 )) && jobs=1; (( jobs > $(nproc) )) && jobs=$(nproc)
  log "building op-reth $RETH_TAG with $jobs jobs (a long step)"
  export RUSTUP_HOME="$TOOLS/rustup" CARGO_HOME="$TOOLS/cargo" PATH="$TOOLS/cargo/bin:$PATH"
  ( cd "$SRC/op-reth/rust" && cargo build --release --bin op-reth -p op-reth -j "$jobs" ) || return 1
  install -m 755 "$SRC/op-reth/rust/target/release/op-reth" "$BIN/op-reth" || return 1
  touch "$STATE/built-op-reth-${RETH_TAG//\//_}"
  rm -rf "$SRC/op-reth/rust/target"
}

build_node() {
  use_prebuilt op-node && return 0
  [[ -f "$STATE/built-op-node-${NODE_TAG//\//_}" && -x "$BIN/op-node" ]] && return 0
  clone_tag "$NODE_TAG" "$SRC/op-node" superchain-registry || return 1
  install_yq || return 1
  log "building op-node $NODE_TAG"
  ( cd "$SRC/op-node" && PATH="$TOOLS/bin:$PATH" bash op-core/superchain/sync-superchain.sh ) || return 1
  ( cd "$SRC/op-node" && PATH="$TOOLS/go/bin:$PATH" GOPATH="$TOOLS/gopath" GOTOOLCHAIN=auto CGO_ENABLED=0 \
      go build -o "$BIN/op-node" -ldflags "-X github.com/ethereum-optimism/optimism/op-node/version.Version=${NODE_TAG##*/}" ./op-node/cmd ) || return 1
  touch "$STATE/built-op-node-${NODE_TAG//\//_}"
}

build_el() {
  if [[ "$EL_FLAVOR" == world-chain ]]; then use_release_tar world-chain; else build_reth; fi
}
# The toolchains are only needed for a binary that has no prebuilt: skip installing them when everything is there.
need_toolchains() {
  if [[ "$EL_FLAVOR" == world-chain ]]; then ! use_prebuilt op-node; else ! { use_prebuilt op-reth && use_prebuilt op-node; }; fi
}
until install_packages && { ! need_toolchains || { install_go && { [[ "$EL_FLAVOR" == world-chain ]] || install_rust; }; }; } && build_el && build_node; do
  log "install/build step failed — retrying in 10 min"
  sleep 600
done

# --- 2. snapshot (once) ----------------------------------------------------------------------------------------------------
kind=full; [[ "$MODE" == archive ]] && kind=archive
SNAP_MARK="$STATE/snapshot-$kind.done"
SNAP_PART="$STATE/snapshot-$kind.inprogress"

# prints "<url> <sha256-url|->" on stdout, returns 1 when no snapshot can be resolved right now
resolve_snapshot() {
  local page file k
  [[ -n "$SNAP_CUSTOM" ]] && { echo "$SNAP_CUSTOM -"; return 0; }
  case "$SNAP_KIND" in
    alchemy) # THIRD PARTY, no checksum: https://www.alchemy.com/snapshots/<SNAP_REF> embeds one public R2 link per client (reth/ and gt/)
      page="$(curl -fsSL "https://www.alchemy.com/snapshots/$SNAP_REF")" || return 1
      file="$(grep -oE "https://pub-[a-z0-9]+\.r2\.dev/rpc-platform/${SNAP_PATH}/reth/reth-[0-9]+\.tar\.gz" <<<"$page" | sort -u | tail -n 1)"
      [[ -n "$file" ]] && echo "$file -" ;;
    gelato) # <SNAP_REF>/index.html lists reth/{full,archival}/datadir/<chain>-reth-<k>-datadir-<block>-<epoch>.tar.lz4 + .sha256
      k=full; [[ "$kind" == archive ]] && k=archival
      page="$(curl -fsSL "https://$SNAP_REF/index.html")" || return 1
      file="$(grep -oE "https://$SNAP_REF/reth/$k/datadir/[A-Za-z0-9._-]+\.tar\.lz4" <<<"$page" | sed -E 's/.*-([0-9]+)\.tar\.lz4$/\1 &/' | sort -n | tail -n 1 | cut -d' ' -f2)"
      [[ -n "$file" ]] && echo "$file $file.sha256" ;;
    fixed) # one stable URL per node type, overwritten daily by the project (no checksum)
      file="$SNAP_URL_FULL"; [[ "$kind" == archive ]] && file="$SNAP_URL_ARCHIVE"
      [[ -n "$file" ]] && echo "$file -" ;;
    *) return 1 ;;
  esac
}

# first member name of the archive: from a local file, or from the first 4 MiB of a remote one ($3 = remote)
list_first() { # $1 = path | url, $2 = name (for the extension), $3 = "remote" | ""
  local dec
  case "${2%%\?*}" in
    *.tar.zst) dec=(zstd -dc) ;;
    *.tar.lz4) dec=(lz4 -dc) ;;
    *.tar.gz|*.tgz) dec=(gzip -dc) ;;
    *) dec=(cat) ;;
  esac
  if [[ "${3:-}" == remote ]]; then
    { curl -fsSL -r 0-4194303 "$1" 2>/dev/null | "${dec[@]}" 2>/dev/null | tar -tf - 2>/dev/null | head -n 1; } || true
  else
    { "${dec[@]}" <"$1" 2>/dev/null | tar -tf - 2>/dev/null | head -n 1; } || true
  fi
}

# datadir members at the top ("./db", "db", "static_files"…) mean there is no wrapper directory to strip
strip_for() { # $1 = first member name
  case "${1%%/*}" in
    .|""|db|static_files|blobstore|rocksdb|reth.toml|jwt.hex|known-peers.json|discovery-secret|invalid_block_hooks|p2p-peerstore.db|proofs-storage|etl-tmp) echo 0 ;;
    *) echo 1 ;;
  esac
}

extract_to() { # $1 = archive path or "-" (stdin), $2 = name (for the extension), $3 = dest, $4 = strip
  case "${2%%\?*}" in
    *.tar.zst) tar -I zstd -xf "$1" -C "$3" --strip-components="$4" ;;
    *.tar.lz4) tar -I lz4 -xf "$1" -C "$3" --strip-components="$4" ;;
    *.tar.gz|*.tgz) tar -xzf "$1" -C "$3" --strip-components="$4" ;;
    *.tar) tar -xf "$1" -C "$3" --strip-components="$4" ;;
    *) return 2 ;;
  esac
}

restore_snapshot() {
  local res url shaurl fname want size free strip first csum
  until res="$(resolve_snapshot)" && [[ -n "$res" ]]; do
    log "no $kind snapshot resolvable ($SNAP_KIND $SNAP_REF) — retrying in 5 min (set restore=none, or a snapshot_url, to skip this)"
    sleep 300
  done
  url="${res%% *}"; shaurl="${res##* }"; fname="${url##*/}"; fname="${fname%%\?*}"
  case "$fname" in *.tar.zst|*.tar.lz4|*.tar.gz|*.tgz|*.tar) ;; *) log "snapshot $fname: unsupported archive type"; exit 2 ;; esac
  log "restoring $fname"
  want=0
  if [[ "$shaurl" != "-" ]]; then
    want="$(curl -fsSL "$shaurl" | awk '{print $1; exit}')"
    [[ ${#want} -eq 64 ]] || { log "bad checksum file for $fname"; exit 1; }
  fi
  size="$(curl -fsSIL "$url" | awk 'tolower($1)=="content-length:" {v=$2} END {gsub("\r","",v); print v}')"
  free="$(df -B1 --output=avail "$SNAPS" | tail -n 1 | tr -d ' ')"
  touch "$SNAP_PART"
  if [[ -n "$size" && -n "$free" && "$free" -gt $((size + size / 20)) ]]; then
    # download (resumable, checked when a checksum exists), then extract, then delete the archive
    if [[ "$want" != 0 ]]; then csum=(--checksum="sha-256=$want"); else csum=(); fi
    until aria2c -c -x 16 -s 16 -k 64M --file-allocation=none --summary-interval=60 --console-log-level=warn \
        "${csum[@]}" -d "$SNAPS" -o "$fname" "$url"; do
      log "snapshot download failed — retrying in 60 s"
      sleep 60
    done
    first="$(list_first "$SNAPS/$fname" "$fname")"
    strip="$(strip_for "$first")"
    log "extracting into $EXEC (strip $strip) — this prints nothing for a long time"
    extract_to "$SNAPS/$fname" "$fname" "$EXEC" "$strip" || { log "extraction failed"; exit 1; }
    rm -f "$SNAPS/$fname"
  else
    # not enough room for archive + datadir: stream (no resume, no checksum)
    log "free space on $SNAPS below the archive size — streaming the restore (not resumable)"
    first="$(list_first "$url" "$fname" remote)"
    strip="$(strip_for "$first")"
    curl -fsSL "$url" | extract_to - "$fname" "$EXEC" "$strip" || { log "streamed extraction failed"; exit 1; }
  fi
  [[ -s "$EXEC/db/mdbx.dat" || -d "$EXEC/static_files" ]] || { log "restored datadir has neither db/mdbx.dat nor static_files — wrong layout"; exit 1; }
  # the snapshot provider's node identity and Engine secret must not be shared with every node restored from it
  rm -f "$EXEC/discovery-secret" "$EXEC/jwt.hex"
  rm -f "$SNAP_PART"
  touch "$SNAP_MARK"
  log "snapshot restored ($kind)"
}

if [[ "$SNAP_WANTED" == 1 && ! -f "$SNAP_MARK" ]]; then
  if [[ -z "$SNAP_CUSTOM" && "$SNAP_KIND" == none ]]; then
    log "no public snapshot exists for $NET $ENV_ID and no snapshot_url was given — op-node derives the chain from L1 (weeks); set a snapshot_url to start from a datadir"
  elif [[ ! -f "$SNAP_PART" && -s "$EXEC/db/mdbx.dat" ]]; then
    log "$EXEC already holds a database — not restoring a snapshot over it"
    touch "$SNAP_MARK"
  else
    restore_snapshot
  fi
fi

# --- 3. engine secret (once) -----------------------------------------------------------------------------------------------
[[ -s "$JWT" ]] || { openssl rand -hex 32 | tr -d '\n' >"$JWT"; chmod 600 "$JWT"; }

reth_args() {
  local a=(node --chain="$RETH_CHAIN" --datadir="$EXEC"
    --http --http.addr="$HTTP_ADDR" --http.port="$HTTP_PORT" --http.api="$HTTP_API"
    --ws --ws.addr="$HTTP_ADDR" --ws.port="$WS_PORT" --ws.api="$HTTP_API"
    --ipcdisable
    --authrpc.addr="$LOOPBACK" --authrpc.port="$ENGINE_PORT" --authrpc.jwtsecret="$JWT"
    --rollup.sequencer="$SEQUENCER" --rollup.disable-tx-pool-gossip --metrics="$LOOPBACK:$METRICS_PORT"
    --port="$P2P_PORT" --discovery.port="$P2P_PORT" --discovery.v5.port="$V5_PORT")
  [[ -n "$EL_TRUSTED" ]] && a+=(--trusted-peers="$EL_TRUSTED")
  # shellcheck disable=SC2206
  [[ -n "$EL_EXTRA" ]] && a+=($EL_EXTRA)
  if [[ "$MODE" != archive ]]; then
    a+=(--prune.minimum-distance="$PRUNE_DISTANCE" --prune.receipts.distance="$PRUNE_DISTANCE"
        --prune.account-history.distance="$PRUNE_DISTANCE" --prune.storage-history.distance="$PRUNE_DISTANCE")
  fi
  apply_extra_flags a
  printf '%s\0' "${a[@]}"
}

node_args() {
  local a=(--l1="$L1_RPC" --l1.rpckind=basic --l1.beacon="$L1_BEACON"
    --l2="ws://$LOOPBACK:$ENGINE_PORT" --l2.jwt-secret="$JWT" --network="$NODE_NETWORK"
    --syncmode="$SYNC_MODE" --l2.enginekind=reth --verifier.l1-confs="$L1_CONFS"
    --rpc.addr="$LOOPBACK" --rpc.port="$CL_RPC"
    --metrics.enabled --metrics.addr="$LOOPBACK" --metrics.port="$CL_METRICS"
    --p2p.listen.tcp="$CL_P2P" --p2p.listen.udp="$CL_P2P"
    --p2p.priv.path="$CONS/p2p_priv.txt" --p2p.peerstore.path="$CONS/peerstore_db" --p2p.discovery.path="$CONS/discovery_db")
  [[ -n "$CL_STATIC" ]] && a+=(--p2p.static="$CL_STATIC")
  [[ -n "$CL_BOOTNODES" ]] && a+=(--p2p.bootnodes="$CL_BOOTNODES")
  printf '%s\0' "${a[@]}"
}

start_reth() {
  mapfile -d '' -t args < <(reth_args)
  "$BIN/$EL_BIN_NAME" "${args[@]}" &
  RETH_PID=$!
  log "$EL_BIN_NAME started (pid $RETH_PID, mode $MODE)"
}

start_node() {
  mapfile -d '' -t args < <(node_args)
  "$BIN/op-node" "${args[@]}" &
  NODE_PID=$!
  log "op-node started (pid $NODE_PID, syncmode $SYNC_MODE)"
}

wait_engine() { for _ in $(seq 1 120); do (echo >"/dev/tcp/127.0.0.1/$ENGINE_PORT") 2>/dev/null && break; sleep 1; done; }

# --- 4. supervise ----------------------------------------------------------------------------------------------------------
log "$NET $ENV_ID starting ($EL_BIN_NAME, op-node $NODE_TAG, $MODE)"
start_reth
wait_engine
start_node
while true; do
  if ! kill -0 "$RETH_PID" 2>/dev/null; then
    log "$EL_BIN_NAME exited — restarting both in 10 s"
    kill -TERM "$NODE_PID" 2>/dev/null; wait "$NODE_PID" 2>/dev/null
    sleep 10
    start_reth
    wait_engine
    start_node
  elif ! kill -0 "$NODE_PID" 2>/dev/null; then
    log "op-node exited — restarting in 10 s"
    sleep 10
    start_node
  fi
  sleep 5 &
  wait $!
done
