[Unit]
Description={{description}}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{node_dir}}
ExecStart={{bin}} \
  --network={{network}} \
  --db-path={{datadir}} \
  --eth-node={{eth_node}} \
  --http \
  --http-host=0.0.0.0 \
  --http-port={{http_port}} \
  --ws \
  --ws-host=0.0.0.0 \
  --ws-port={{ws_port}} \
  --metrics \
  --metrics-host=127.0.0.1 \
  --metrics-port={{metrics_port}} \
  --db-cache-size={{db_cache_size}} \
  --rpc-max-block-scan={{rpc_max_block_scan}} \
  --rpc-request-timeout={{rpc_request_timeout}} \
  --log-level=info{{prune_flags}}
Restart=on-failure
RestartSec=10
TimeoutStopSec=300
StandardOutput=append:{{log_file}}
StandardError=append:{{log_file}}
LimitNOFILE={{limit_nofile}}
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
