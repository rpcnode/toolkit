# managed by rpcnode — zksync-era external node ({{network}} / {{env}}); rewritten on every Start
# --- identity / L1 ---
EN_L2_CHAIN_ID={{l2_chain_id}}
EN_L1_CHAIN_ID={{l1_chain_id}}
EN_MAIN_NODE_URL={{main_node_url}}
EN_ETH_CLIENT_URL={{l1_rpc}}
{{gateway_line}}
# --- ports (catalog) ---
EN_HTTP_PORT={{http_port}}
EN_WS_PORT={{ws_port}}
EN_HEALTHCHECK_PORT={{health_port}}
EN_PROMETHEUS_PORT={{metrics_port}}
# --- storage ---
DATABASE_POOL_SIZE={{db_pool_size}}
EN_STATE_CACHE_PATH={{state_cache_path}}
EN_MERKLE_TREE_PATH={{merkle_tree_path}}
# --- snapshot recovery / pruning (the EN restores itself from the public GCS bucket on first start) ---
EN_SNAPSHOTS_RECOVERY_ENABLED={{snapshots_recovery}}
EN_SNAPSHOTS_OBJECT_STORE_BUCKET_BASE_URL={{snapshots_bucket}}
EN_SNAPSHOTS_OBJECT_STORE_MODE=GCSAnonymousReadOnly
EN_PRUNING_ENABLED={{pruning_enabled}}
EN_PRUNING_DATA_RETENTION_SEC={{pruning_retention_sec}}
# --- public RPC capacity ---
EN_API_NAMESPACES={{api_namespaces}}
EN_REQ_ENTITIES_LIMIT={{req_entities_limit}}
EN_FILTERS_LIMIT={{filters_limit}}
EN_SUBSCRIPTIONS_LIMIT={{subscriptions_limit}}
EN_PUBSUB_POLLING_INTERVAL=200
EN_MAX_NONCE_AHEAD=50
EN_GAS_PRICE_SCALE_FACTOR=1.5
EN_ESTIMATE_GAS_SCALE_FACTOR=1.3
EN_ESTIMATE_GAS_ACCEPTABLE_OVERESTIMATION=5000
EN_MAX_TX_SIZE=1000000
EN_MAX_RESPONSE_BODY_SIZE_MB={{max_response_mb}}
EN_MAX_RESPONSE_BODY_SIZE_OVERRIDES_MB={{max_response_overrides}}
EN_LATEST_VALUES_CACHE_SIZE_MB={{latest_values_cache_mb}}
# --- logging ---
MISC_LOG_FORMAT=plain
RUST_LOG=warn,zksync=info,zksync_web3_decl::client=error
RUST_BACKTRACE=1
# --- chain specific (validium DA, state keeper deadline, ...) ---
{{extra_lines}}
