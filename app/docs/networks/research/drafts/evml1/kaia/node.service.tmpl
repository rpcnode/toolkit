# ken (Kaia Endpoint Node). {{network_flag}} = --mainnet | --kairos. Flag set = the official kend.conf defaults (kaiachain/kaia build/rpm/etc/kend/conf/kend.conf),
# minus daemon/log-rotation options (systemd owns the process and the log). --state.live-pruning matches the live-pruned snapshot (INFERRED, see risks.md).
# --prometheusport flag name INFERRED from metricutils.PrometheusExporterPortFlag; verify with `ken --help` at the pinned version.
[Unit]
Description={{description}}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{bin}} {{network_flag}} \
  --datadir {{datadir}} \
  --port {{p2p_port}} --subport {{subport}} --multichannel \
  --srvtype http \
  --syncmode full \
  --state.live-pruning \
  --maxconnections 10 \
  --verbosity 3 \
  --txpool.exec-slots.all 4096 --txpool.nonexec-slots.all 4096 \
  --txpool.exec-slots.account 4096 --txpool.nonexec-slots.account 4096 \
  --txpool.lifetime 30m \
  --rpc --rpcaddr 0.0.0.0 --rpcport {{http_port}} \
  --rpcapi klay,eth,net,web3 \
  --rpccorsdomain "*" --rpcvhosts "*" \
  --rpc.concurrencylimit 3000 \
  --rpcreadtimeout 30 --rpcwritetimeout 30 --rpcidletimeout 120 --rpcexecutiontimeout 30 \
  --ws --wsaddr 0.0.0.0 --wsport {{ws_port}} \
  --wsapi klay,eth,net,web3 --wsorigins "*" \
  --metrics --prometheus --prometheusport {{metrics_port}}
Restart=on-failure
RestartSec=10
TimeoutStopSec=300
StandardOutput=append:{{log_file}}
StandardError=append:{{log_file}}
LimitNOFILE=1048576
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
