' toolkit-kotlin — UML for the IDE (PlantUML 1.2024+)
' IntelliJ: PlantUML integration → open file → Alt+D
' Diagrams: @startuml <name> — switch in preview

@startuml toolkit-deployment
title Deployment: admin + panel + agent + cdn

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 11

actor Browser

component "admin React SPA\npages + api.ts" as Admin

package "rpcnode-server (src/main :8094)" {
  component "Application.kt" as AppMain
  component "panel Routes.kt" as Routes
  component "Toolkit.kt" as Toolkit
  component "Use cases" as UseCases
  database "toolkit.db" as DB
  component "YAML catalogs" as Yaml
}

package "rpcnode-agent (src/agent)" {
  component "AgentMain.kt" as AgentMain
  component "AgentRoutes.kt" as AgentRoutes
  component "agent use cases" as AgentUC
}

package "rpcnode-cdn (src/cdn)" {
  component "CdnMain.kt" as CdnMain
  component "WatchSnapshotsUseCase" as WatchCdn
  component "LocalSnapshotSource" as LocalSrc
}

node "remote host" {
  component "client binary" as ClientBin
}

cloud "CDN host" {
  component "nginx snapshots" as Nginx
}

cloud "official mirrors" as Official

AppMain --> Routes
Routes --> Toolkit
Toolkit --> UseCases
UseCases --> DB
UseCases --> Yaml

AgentMain --> AgentRoutes
AgentRoutes --> AgentUC
CdnMain --> WatchCdn
WatchCdn --> LocalSrc

Browser --> Admin
Admin --> Routes : REST /api/*
AgentUC --> Routes : POST metrics
Routes --> AgentRoutes : HttpHostAgentClient
LocalSrc --> Official : discover + download
AgentUC --> ClientBin
UseCases ..> Nginx : PreferCdnSnapshot
Admin ..> Nginx : snapshot URL

@enduml


@startuml toolkit-layers
title Hexagonal layers (template for each slice)

skinparam shadowing false
skinparam packageStyle rectangle

package "Presentation (panel only)" {
  class Routes <<Ktor>> {
    panel/slice/presentation/http
    *Routes.kt
  }
}

package Application {
  class UseCase {
    suspend invoke()
  }
  interface Port {
    HostAgentClient
    UrlProbe
  }
}

package Domain {
  class Model
  interface RepoIface
}

package Infrastructure {
  class SqliteRepo
  class HttpAdapter
  class YamlCatalog
}

Routes --> UseCase : Command
UseCase --> Model
UseCase --> RepoIface
UseCase --> Port
SqliteRepo ..|> RepoIface
HttpAdapter ..|> Port
YamlCatalog ..|> RepoIface

note bottom of Routes
  Business logic NOT in panel.*
  panel = HTTP only
end note

@enduml


