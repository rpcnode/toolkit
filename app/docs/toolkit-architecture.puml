@startuml toolkit-tron-snapshot-mirrors
title TRON official snapshot mirrors + CDN by type

skinparam shadowing false

file "networks/tron.yml\nsnapshotTypes:\n full / lite / archive" as NetYml
file "clients/tron.yml\nsnapshots:\n mirror roots" as CliYml

rectangle "Official mirrors (clients/tron.yml)" as Official {
  card "mainnet/full\nhttp://34.86.86.229/" as MFull
  card "mainnet/internal_tx\nhttp://35.247.128.170/" as MInt
  card "mainnet/archive\nhttp://34.48.6.163/" as MArch
  card "nile/full · nile/lite\nhttps://snapshots.nileex.io/\n(dated HEAD)" as MNile
}

rectangle "Panel" as Panel {
  component "TronSnapshotResolver(type)" as Resolver
  component "PreferCdnSnapshotUseCase" as Prefer
  database "nodes.install_options_json\n{ snapshot: full|lite|… }" as Opts
}

rectangle "Snapshot CDN" as Cdn {
  folder "/snapshots/tron/mainnet/full/" as CdnFull
  folder "/snapshots/tron/mainnet/archive/" as CdnArch
  folder "/snapshots/tron/nile/lite/" as CdnLite
}

NetYml --> Panel : wizard choices
CliYml --> Official
Official --> Resolver
Opts --> Prefer : type id
Resolver --> Prefer : official archive URL
Prefer --> Cdn : prefer when VERSION matches
Prefer --> Official : else official

note bottom of Official
  Mirror IPs/hosts must stay in clients/tron.yml
  (and this diagram) — not in networks/*.yml.
end note

@enduml
