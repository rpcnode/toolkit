@startuml toolkit-wiring-classes
title Toolkit + repositories

skinparam shadowing false

class Toolkit {
  +catalog
  +listNetworks
  +getSettings
  +listClients
  +syncClients
  +listServers
  +registerServer
  +addNode
  +getNodePorts
  +checkNodePorts
  +preferCdnSnapshot
  --
  +production(cfg)
}

class Application {
  +main()
  +module(cfg, toolkit)
}

interface NodeRepository {
  +list()
  +find(id)
  +insert()
}

interface ServerRepository {
  +find(id)
  +save()
  +list()
}

interface SettingsStore {
  +read()
  +save()
}

interface HostAgentClient {
  +enroll()
  +identity()
  +checkPorts()
  +update()
}

interface NetworkCatalog

class AddNodeUseCase
class RegisterServerUseCase
class CheckNodePortsUseCase
class HttpHostAgentClient
class SqliteNodeRepository
class SqliteServerRepository
class SqliteSettingsStore
class YamlClientProgramCatalog
class YamlNetworkFactsRepository

Application --> Toolkit
Toolkit *-- AddNodeUseCase
Toolkit *-- RegisterServerUseCase
Toolkit *-- CheckNodePortsUseCase

AddNodeUseCase --> NodeRepository
AddNodeUseCase --> ServerRepository
RegisterServerUseCase --> ServerRepository
RegisterServerUseCase --> HostAgentClient
CheckNodePortsUseCase --> NodeRepository
CheckNodePortsUseCase --> HostAgentClient

