@enduml


@startuml toolkit-sequence-register-server
title Sequence: register host

actor Admin as "ServersPage"
participant Routes as "ServersRoutes"
participant UC as "RegisterServerUseCase"
participant Repo as "SqliteServerRepository"
participant Agent as "HttpHostAgentClient"

Admin -> Routes : POST /api/servers
Routes -> UC : invoke
UC -> Agent : POST /api/v1/enroll
Agent --> UC : ok
UC -> Agent : GET /api/v1/agent
Agent --> UC : identity
UC -> Repo : save
Repo --> UC
UC --> Routes : Created
Routes --> Admin : 200

@enduml


@startuml toolkit-sequence-add-node
title Sequence: add node

actor Admin as "NodesPage"
participant Routes as "NodesRoutes"
participant UC as "AddNodeUseCase"
participant Nodes as "NodeRepository"
participant Servers as "ServerRepository"
participant Catalog as "NetworkCatalog"
participant Clients as "ClientVersionRepository"

Admin -> Routes : POST /api/nodes
Routes -> UC : invoke
UC -> Servers : find
UC -> Catalog : validate
UC -> Clients : check installed
UC -> Nodes : insert AWAITING_PORTS
Nodes --> UC : Created
UC --> Routes : Created
Routes --> Admin : 200

@enduml


@startuml toolkit-sequence-node-ports
title Sequence: check node ports

actor Admin as "NodePortsPanel"
participant Routes as "NodesRoutes"
participant UC as "CheckNodePortsUseCase"
participant Nodes as "NodeRepository"
participant Catalog as "ClientProgramCatalog"
participant Agent as "HttpHostAgentClient"

Admin -> Routes : POST ports/check
Routes -> UC : invoke
UC -> Nodes : find
UC -> Catalog : fixed ports
UC -> Agent : POST agent/ports/check
Agent --> UC : statuses
UC --> Routes : result
Routes --> Admin : json

@enduml


